{
  "semantic": {
    "description": "语义检索与图片描述",
    "type": "object",
    "items": {
      "enabled": {
        "description": "使用向量检索",
        "type": "bool",
        "default": true,
        "hint": "索引和模型就绪时使用向量匹配；关闭或索引未就绪时使用图片描述、关键词和分类匹配。"
      },
      "top_k": {
        "description": "默认候选数",
        "type": "int",
        "default": 8,
        "slider": { "min": 1, "max": 30, "step": 1 },
        "hint": "检索工具未指定候选数时使用此值；直接选图工具始终只选择一张。"
      },
      "min_score": {
        "description": "最低匹配分",
        "type": "float",
        "default": 0.02,
        "slider": { "min": 0, "max": 1, "step": 0.01 },
        "hint": "检索和直接选图都会过滤低于此分数的结果。提高后候选更少，过高可能没有结果。"
      },
      "vision_provider_id": {
        "description": "图片描述模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "选择 Alma 中支持图片输入的模型，用于语义化页面生成图片描述。留空时自动选择可用的视觉模型。"
      }
    }
  },
  "search": {
    "description": "分类过滤",
    "type": "object",
    "items": {
      "exclude_categories": {
        "description": "默认排除的分类",
        "type": "list",
        "default": ["color"],
        "hint": "每行填写一个分类名。自动检索会跳过这些分类；明确指定某一分类时仍可搜索该分类。"
      }
    }
  },
  "webui": {
    "description": "页面预览",
    "type": "object",
    "items": {
      "preview_concurrency": {
        "description": "预览加载并发数",
        "type": "int",
        "default": 2,
        "slider": { "min": 1, "max": 8, "step": 1 },
        "hint": "每个页面同时加载的图片数量。保存后刷新管理页面生效。"
      }
    }
  }
}
